rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can read all collections
    // (teachers need to see co-teachers, classes, shared question logs)

    // A Head of Department has a teachers doc at "<uid>__hod"
    function isHoD() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid + '__hod'));
    }

    match /teachers/{docId} {
      allow read: if request.auth != null;
      // Users can write their own teacher documents (docId starts with their uid);
      // an HoD may also remove/adjust any teacher's enrollment.
      allow write: if request.auth != null &&
        (docId.matches(request.auth.uid + '__.*') || isHoD());
    }

    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /question_log/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /session_log/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /plaza_messages/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /plaza_stats/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
